# ==============================================================================
# URBIS MAP - BACKEND API (.env.example)
# ==============================================================================
# Este arquivo documenta todas as variáveis de ambiente utilizadas pela API NestJS
# do Urbis Map (apps/api). Copie para `.env` para execução local ou desenvolvimento.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AMBIENTE E SERVIDOR HTTP
# ------------------------------------------------------------------------------
# Ambiente de execução: development | staging | production | test
NODE_ENV=development

# Opções do Node V8 (ajuste de limite de heap de memória em MB, ex: 896, 1024)
NODE_OPTIONS="--max-old-space-size=896"

# Porta do servidor HTTP
APP_PORT=3000

# Nome da aplicação exibido na documentação Swagger / logs
APP_NAME="Urbis Map API"

# Prefixo global das rotas da API (ex: /api/v1 ou /api)
API_PREFIX=api

# Idiomas e i18n
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
I18N_DIRECTORY=src/i18n

# Domínios de integração (CORS e redirecionamentos)
FRONTEND_DOMAIN=http://localhost:4200
BACKEND_DOMAIN=http://localhost:3000
ACCOUNTS_URL=http://localhost:4200

# Habilitar interface do Swagger OpenAPI (true/false)
SWAGGER_ENABLED=true

# Confiança em cabeçalhos de Proxy reverso (ex: X-Forwarded-For no Nginx Ingress)
# true | false | 1
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS POSTGRESQL / POSTGIS
# ------------------------------------------------------------------------------
# Tipo do banco de dados suportado pelo TypeORM (postgres)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=urbis
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100

# Configurações de SSL para conexões gerenciadas (Azure Database for PostgreSQL / AWS RDS)
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# Certificados opcionais para SSL mTLS / CA customizada
# DATABASE_CA=
# DATABASE_KEY=
# DATABASE_CERT=

# ------------------------------------------------------------------------------
# 3. CACHE E SESSÕES REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=1
REDIS_TLS=false

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO JWT E DOIS FATORES (2FA TOTP)
# ------------------------------------------------------------------------------
# Segredo para assinatura de tokens JWT da aplicação
AUTH_SECRET=secret_jwt_min_32_characters_long_for_security

# Chave de API para rotas administrativas internas / microsserviços
AUTH_API_KEY=internal_api_key_secret

# Tabela do banco para persistência de sessões
AUTH_SESSION_TABLE=session

# Tempo de expiração do JWT (ex: 1d, 7d, 3600s)
AUTH_JWT_TOKEN_EXPIRES_IN=7d

# 2FA / TOTP (Time-based One-time Password)
TWO_FACTORY_APP_NAME="UrbisAccount"
TWO_FACTORY_SECRET="a27d0702331e500fa9be21baf002fe1f486b6ebee81a122fd6b1057eeadc6566"

# ------------------------------------------------------------------------------
# 5. OIDC EXTERNO (GOV.BR / ACESSO CIDADAO)
# ------------------------------------------------------------------------------
EXTERNAL_OIDC_JWKS_URI=https://sso.acesso.gov.br/jwk
EXTERNAL_OIDC_AUTHORITY=https://sso.acesso.gov.br
EXTERNAL_OIDC_CLIENT_ID=p-urbis.prefeitura.sp.gov.br
EXTERNAL_OIDC_CLIENT_SECRET=your_oidc_client_secret_here

# ------------------------------------------------------------------------------
# 6. SEEDS E CONTA ADMINISTRADORA INICIAL
# ------------------------------------------------------------------------------
ADMIN_ORGANIZATION_ID=964b5546-31b7-407c-b139-0d44076f08b6
ADMIN_ORGANIZATION_NAME=admin
ADMIN_ACCOUNT_EMAIL=admin@urbis.prefeitura.sp.gov.br
ADMIN_ACCOUNT_PASSWORD=ChangeMeStrongPassword123!

# ------------------------------------------------------------------------------
# 7. GEOSERVER / WFS / WMS & MAP PROXY
# ------------------------------------------------------------------------------
# URL base do GeoServer onde as camadas PostGIS são publicadas
GEOSERVER_URL=https://geoserver.example.com/geoserver
GEOSERVER_BASE_URL=https://geoserver.example.com/geoserver/ows
GEOSERVER_BEARER_TOKEN=Bearer your_geoserver_bearer_token_here
GEOSERVER_USER=dagster
GEOSERVER_PASSWORD=your_geoserver_password_here

# Base URL para reescrita e proxy reverso de camadas do mapa
MAP_PROXY_BASE_URL=http://localhost:3000

# Limite de área máxima em km² para cálculos de interseção espacial
MAX_POLYGON_AREA_KM2=25

# ------------------------------------------------------------------------------
# 8. GEOCODING / NOMINATIM / BUSCA DE ENDEREÇOS
# ------------------------------------------------------------------------------
DEFAULT_SERVICE=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODING_PROVIDER_URL=
GEOCODING_PROVIDER_ACCESS_TOKEN=
MIN_ZOOM_LOTE=17
BBOX_SEARCH="-46.825,-24.008,-46.365,-23.356"

# ------------------------------------------------------------------------------
# 9. PROVEDORES DE E-MAIL (AZURE COMMUNICATION / SENDGRID)
# ------------------------------------------------------------------------------
# Provedor: azure | sendgrid
MAIL_PROVIDER=azure

# Se MAIL_PROVIDER=azure
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING="endpoint=https://your-resource.brazil.communication.azure.com/;accesskey=your_access_key"

# Se MAIL_PROVIDER=sendgrid
MAIL_SENDGRID_API_KEY=

MAIL_TEMPLATES_PATH=src/common/mail/templates
MAIL_FROM=naoresponda@urbis.prefeitura.sp.gov.br

# ------------------------------------------------------------------------------
# 10. ARMAZENAMENTO DE ARQUIVOS (AWS S3 / AZURE BLOB VIA S3PROXY / MINIO)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_S3_REGION=us-east-1
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=storage
AWS_S3_PUBLIC_BUCKET=public
AWS_S3_PRIVATE_BUCKET=private

# ------------------------------------------------------------------------------
# 11. INTELIGÊNCIA ARTIFICIAL E SEGURANÇA
# ------------------------------------------------------------------------------
# Provedor de Imagens de Satélite Maxar
MAXAR_API_KEY=

# Google reCAPTCHA v3
GOOGLE_RECAPTCHA_SECRET_KEY=

# Google Gemini / Generative AI API Key
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------------------
# 12. LIMITAÇÃO DE TAXA (RATE LIMITING / THROTTLER)
# ------------------------------------------------------------------------------
THROTTLER_ENABLED=false
THROTTLER_SHORT_TTL=1000
THROTTLER_SHORT_LIMIT=5
THROTTLER_MEDIUM_TTL=60000
THROTTLER_MEDIUM_LIMIT=60
THROTTLER_DAILY_TTL=86400000
THROTTLER_DAILY_LIMIT=1000

# Limites específicos para usuários anônimos via Proxy
THROTTLER_PROXY_ANONYMOUS_SHORT_LIMIT=5
THROTTLER_PROXY_ANONYMOUS_MEDIUM_LIMIT=60
THROTTLER_PROXY_ANONYMOUS_DAILY_LIMIT=500

# Limites para usuários autenticados via Proxy
THROTTLER_PROXY_AUTHENTICATED_SHORT_LIMIT=20
THROTTLER_PROXY_AUTHENTICATED_MEDIUM_LIMIT=300
THROTTLER_PROXY_AUTHENTICATED_DAILY_LIMIT=1000

# ------------------------------------------------------------------------------
# 13. OBSERVABILIDADE E ANALYTICS (POSTHOG)
# ------------------------------------------------------------------------------
# POSTHOG_KEY=phc_your_posthog_project_api_key
# POSTHOG_HOST=https://eu.i.posthog.com
