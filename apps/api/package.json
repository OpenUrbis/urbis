{
  "name": "@open-urbis/map-api",
  "version": "0.1.0",
  "description": "Urbis Map OpenAPI.",
  "author": "Anon(@anon)",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "prebuild": "rimraf dist/app",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,infra,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "npx env-cmd -- node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- --dataSource=src/common/database/cli.data-source.ts migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- --dataSource=src/common/database/cli.data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- --dataSource=src/common/database/cli.data-source.ts migration:revert",
    "documentation": "npx @compodoc/compodoc -p tsconfig.json --includesName Documentation --includes docs --theme stripe",
    "documentation:serve": "npx @compodoc/compodoc -p tsconfig.json --includesName Documentation --includes docs --theme stripe -s",
    "schema:drop": "npx env-cmd -- ts-node ./src/common/database/drop-all.ts",
    "seed:run": "npx env-cmd -- ts-node -r tsconfig-paths/register ./src/common/database/seeds/run-seed.ts",
    "seed:map-config": "npx env-cmd -- ts-node -r tsconfig-paths/register ./src/common/database/seeds/run-map-config-seed.ts",
    "db:reset": "npm run schema:drop && npm run migration:run && npm run seed:run",
    "db:reset-representations": "npx env-cmd -- ts-node -r tsconfig-paths/register scripts/reset-representations.ts",
    "db:delete-legis-pages": "npx env-cmd -- ts-node -r tsconfig-paths/register scripts/delete-legis-pages.ts",
    "db:delete-layer-schemas": "npx env-cmd -- ts-node -r tsconfig-paths/register scripts/delete-layer-schemas.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.6",
    "@aws-sdk/client-s3": "^3.808.0",
    "@aws-sdk/s3-request-presigner": "^3.808.0",
    "@azure/communication-email": "^1.1.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestlab/google-recaptcha": "^3.10.0",
    "@ntegral/nestjs-sendgrid": "^1.0.0",
    "@open-urbis/map-shared": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "@turf/turf": "^7.2.0",
    "ai": "^6.0.29",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.5",
    "bull": "^4.16.5",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^4.1.0",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "fix-esm": "^1.0.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.2",
    "jwks-rsa": "^3.2.0",
    "keygrip": "^1.1.0",
    "lodash": "^4.17.21",
    "mime-types": "^3.0.2",
    "multer": "2.2.0",
    "nestjs-i18n": "^10.4.5",
    "oidc-provider": "^9.5.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "posthog-node": "^5.49.1",
    "proj4": "^2.15.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.0",
    "turbo": "^2.5.0",
    "typeorm": "^0.3.20",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.24.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@eslint/markdown": "^6.3.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^4.10.4",
    "@types/cheerio": "^1.0.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.17",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^29.5.2",
    "@types/keygrip": "^1.0.6",
    "@types/lodash": "^4.17.21",
    "@types/mime-types": "^3.0.1",
    "@types/minimatch": "^6.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/oidc-provider": "^8.8.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/proj4": "^2.5.6",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^16.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.29.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^common/(.*)$": "<rootDir>/common/$1"
    },
    "modulePaths": [
      "<rootDir>"
    ]
  }
}
