{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/search.json",
      "/api/*",
      "/llms-full.txt",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,css,js,json,txt,woff,woff2}"
    ]
  },
  "routes": [
    {
      "route": "/",
      "redirect": "/docs/",
      "statusCode": 301
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "Cache-Control": "public, max-age=3600"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".txt": "text/plain"
  }
}
