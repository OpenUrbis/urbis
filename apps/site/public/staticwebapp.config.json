{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.png",
      "/*.jpg",
      "/*.ico",
      "/*.svg",
      "/*.webmanifest"
    ]
  },
  "globalHeaders": {
    "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0",
    "Pragma": "no-cache",
    "Expires": "0"
  },
  "routes": [
    {
      "route": "/info-urbis",
      "redirect": "/guia-legislacao-urbanistica",
      "statusCode": 301
    },
    {
      "route": "/licencas",
      "redirect": "/guia-fiscalizacao-urbanistica",
      "statusCode": 301
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}
