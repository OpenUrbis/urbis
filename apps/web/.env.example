# ==============================================================================
# URBIS MAP - WEB APPLICATION (MAPA INTERATIVO) (.env.example)
# ==============================================================================

# URL da API do Urbis Map
VITE_API_URL=http://localhost:3000

# URL do portal de contas/autenticação
VITE_ACCOUNTS_URL=http://localhost:4200

# Token público do Mapbox / MapLibre (se aplicável para tiles vetoriais)
VITE_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token_here

# Configurações de Autenticação OIDC (OpenID Connect / Urbis Accounts)
VITE_OIDC_AUTHORITY=http://localhost:3000/auth/oidc
VITE_OIDC_CLIENT_ID=94a86322-269e-44df-803a-534c0382215d
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:5173/silent-renew.html
