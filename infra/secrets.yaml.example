# ==============================================================================
# URBIS MAP - VALORES DE SEGREDOS (HELM SECRETS TEMPLATE)
# ==============================================================================
# Copie este arquivo para `secrets.yaml` e preencha com as credenciais reais.
# NUNCA comite o arquivo `secrets.yaml` no controle de versão (Git).
# ==============================================================================

base:
  certManager:
    email: "admin@urbis.example.com"

components-apps:
  api:
    secrets:
      # Banco de Dados PostgreSQL (Managed Azure / AWS RDS / Local)
      databaseUsername: "postgres"
      databasePassword: "YOUR_POSTGRES_PASSWORD"

      # Cache & Sessões Redis
      redisPassword: "YOUR_REDIS_PASSWORD"

      # Autenticação JWT e Chaves Internas da Aplicação
      authSecret: "YOUR_APP_JWT_SECRET_32_CHARS_MIN"
      authApiKey: "YOUR_APP_API_KEY_SECRET"
      twoFactorSecret: "YOUR_2FA_TOTP_SECRET_64_HEX"

      # Provedor OIDC Externo (Ex: ConectaGov / Gov.br Acesso)
      externalOidcClientSecret: "YOUR_GOVBR_OIDC_CLIENT_SECRET"

      # Autenticação no GeoServer (REST API e WFS/WMS)
      geoserverBearerToken: "Bearer YOUR_GEOSERVER_BEARER_TOKEN"
      geoserverPassword: "YOUR_GEOSERVER_PASSWORD"

      # Provedores Espaciais & Imagens de Satélite
      maxarApiKey: "YOUR_MAXAR_API_KEY"

      # Google reCAPTCHA v3 & Google Gemini AI
      googleRecaptchaSecretKey: "YOUR_RECAPTCHA_SECRET_KEY"
      googleGenerativeAiApiKey: "YOUR_GEMINI_API_KEY"

      # Provedores de Envio de E-mail
      azureCommunicationServicesConnectionString: "endpoint=https://YOUR_RESOURCE.brazil.communication.azure.com/;accesskey=YOUR_ACCESS_KEY"
      mailSendgridApiKey: "YOUR_SENDGRID_API_KEY" # Opcional se MAIL_PROVIDER=sendgrid

      # Credenciais do S3 / MinIO / S3Proxy
      awsAccessKey: "YOUR_S3_ACCESS_KEY"
      awsSecretAccessKey: "YOUR_S3_SECRET_ACCESS_KEY"

  storage:
    secrets:
      # Credenciais S3Proxy (Cliente S3 <-> Azure Blob / S3)
      identity: "YOUR_S3PROXY_IDENTITY"
      credential: "YOUR_S3PROXY_CREDENTIAL"

      # Credenciais de acesso ao Azure Blob Storage (Storage Account)
      jcloudsIdentity: "your_azure_storage_account_name"
      jcloudsCredential: "YOUR_AZURE_STORAGE_ACCOUNT_PRIMARY_KEY"

# Docker Hub / Container Registry Credentials para Image Pull
dockerConfig: |
  {
    "auths": {
      "https://index.docker.io/v1/": {
        "username": "YOUR_DOCKERHUB_USERNAME",
        "password": "YOUR_DOCKERHUB_PASSWORD_OR_TOKEN",
        "email": "you@example.com",
        "auth": "BASE64_OF_USERNAME_COLON_PASSWORD"
      }
    }
  }
