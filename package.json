{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test -- --passWithNoTests",
    "composer:up": "docker-compose -f apps/api/docker-compose.yaml up -d",
    "composer:down": "docker-compose -f apps/api/docker-compose.yaml down",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.4.4"
  },
  "name": "urbis-map",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.1",
      "@types/react-dom": "^18.3.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "@luma.gl/core": "9.2.5",
    "@luma.gl/engine": "9.2.5",
    "@luma.gl/webgl": "9.2.5",
    "@luma.gl/shadertools": "9.2.5",
    "@luma.gl/constants": "9.2.5",
    "deck.gl": "9.2.5",
    "@deck.gl/core": "9.2.5",
    "@deck.gl/layers": "9.2.5",
    "@deck.gl/geo-layers": "9.2.5",
    "@deck.gl/mapbox": "9.2.5",
    "@deck.gl/json": "9.2.5",
    "@deck.gl/react": "9.2.5",
    "@deck.gl/aggregation-layers": "9.2.5",
    "@deck.gl/extensions": "9.2.5",
    "@deck.gl/mesh-layers": "9.2.5",
    "@deck.gl/widgets": "9.2.5",
    "@deck.gl/google-maps": "9.2.5",
    "@deck.gl/carto": "9.2.5",
    "@deck.gl/arcgis": "9.2.5"
  },
  "dependencies": {
    "@ng-icons/core": "^33.0.0",
    "@ng-icons/lucide": "^33.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "proj4": "^2.20.2",
    "tailwind-merge": "^3.4.0"
  }
}
