{
  "name": "@open-urbis/map",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint \"**/*.ts*\"",
    "build": "tsc",
    "clean:artifacts": "find src -name '*.js' -delete && find src -name '*.d.ts' -not -name 'vite-env.d.ts' -delete && find src -name '*.d.ts.map' -delete"
  },
  "exports": {
    ".": "./src/index.ts",
    "./examples/*": "./src/examples/*"
  },
  "license": "MIT",
  "dependencies": {
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0",
    "@deck.gl/react": "^9.0.0",
    "@open-urbis/endereco-digital": "workspace:*",
    "@open-urbis/map-auth": "workspace:*",
    "@open-urbis/map-shared": "workspace:*",
    "@open-urbis/map-ui": "workspace:*",
    "@preact/signals": "^1.3.1",
    "@preact/signals-react": "^2.0.1",
    "deck.gl": "^9.0.0",
    "mapbox-gl": "^3.9.0",
    "open-location-code": "^1.0.3",
    "polylabel": "^1.1.0",
    "proj4": "^2.11.0",
    "react-map-gl": "^7.1.7"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@open-urbis/map-eslint-config": "workspace:*",
    "@open-urbis/map-typescript-config": "workspace:*",
    "@types/mapbox-gl": "^3.4.1",
    "@types/minimatch": "^6.0.0",
    "@types/proj4": "^2.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.24.0",
    "typescript": "5.5.4"
  }
}
